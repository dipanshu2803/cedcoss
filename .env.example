# Server Configuration
PORT=5000
NODE_ENV=development

# LLM Provider Configuration
# Choose one of: 'gemini', 'groq', 'openrouter', or 'mock'
# 'mock' mode runs entirely offline with realistic deterministic analysis (great for testing without API keys!)
LLM_PROVIDER=gemini

# Google Gemini API Key (Free tier at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq API Key (Optional free tier at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter API Key (Optional free tier at https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Batch & Processing Settings
BATCH_SIZE=5
MAX_RETRIES=3
BASE_BACKOFF_MS=1000
